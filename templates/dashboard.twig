{# templates/blog/layout.html.twig #}
{% extends 'base.html.twig' %}

{% block content %}
	<h1>{{ typeLabel }}</h1>

	<a class="btn btn-primary" href="{{ path('dispatch', {type: typeValue}) }}">Fetch all listings now!</a>

	<div class="float-end">
			{{ form_start(form) }}
		<div class="row row-cols-lg-auto g-3 align-items-center">
			<div class="col">{{ form_widget(form.willhabenId) }}</div>
			<div class="col">{{ form_widget(form.submit) }}</div>
		</div>
			{{ form_end(form) }}
	</div>

    <h2>
        {{ totalCount }} {{ typeLabel }} total /
        {{ activeLastMonth }} aktiv im letzten Monat /
        {{ soldLastMonth }} "verkauft" im letzten Monat
    </h2>

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item">
            <a class="nav-link {{ typeValue == 'house' ? 'active' : '' }}" href="{{ path('dashboard_house') }}">Häuser</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ typeValue == 'land' ? 'active' : '' }}" href="{{ path('dashboard_land') }}">Grundstücke</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="{{ path('starred') }}"><i class="fas fa-star"></i></a>
        </li>
    </ul>

    <h2 class="mt-4">Statistik {{ typeLabel }}</h2>
	{{ render(controller(
		'App\\Controller\\ListingsController::scatterChartStats', {type: typeValue}
	)) }}

    <h2 class="mt-4">Preisentwicklung {{ typeLabel }}</h2>
    {{ render(controller(
        'App\\Controller\\ListingsController::priceTrend', {type: typeValue}
    )) }}

    <div class="my-3">

	<table class="table table" id="listings-table">
		<thead>
		<tr>
			<th>Title</th>
			<th>Source</th>
			<th>m²</th>
			<th>€ current</th>
			<th>% Sale</th>
			<th>€/m² current</th>
			<th>€ Max</th>
			<th>€ Min</th>
			<th>€/m² max</th>
			<th>€/m² min</th>
			<th>First seen</th>
			<th>Last seen</th>
			<th>Age</th>
			<th>Pics</th>
		</tr>
		</thead>
		<tbody>
		</tbody>
	</table>
    </div>

    <script>
        $(function () {
            $('#listings-table').DataTable({
                serverSide: true,
                processing: true,
                order: [[10, 'desc']],
                ajax: {
                    url: '{{ path('render_listing_rows', {type: typeValue}) }}',
                    type: 'GET'
                },
                columns: [
                    { data: 'title' },
                    { data: 'source' },
                    { data: 'area' },
                    { data: 'price' },
                    { data: 'sale' },
                    { data: 'pricePerArea' },
                    { data: 'priceMax' },
                    { data: 'priceMin' },
                    { data: 'pricePerAreaMax' },
                    { data: 'pricePerAreaMin' },
                    { data: 'firstSeen' },
                    { data: 'lastSeen' },
                    { data: 'ageInWeeks' },
                    { data: 'pics' },
                ]
            });
        });
    </script>

{% endblock %}
